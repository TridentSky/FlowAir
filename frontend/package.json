{
  "name": "flowair",
  "productName": "FlowAir",
  "version": "2.2.1",
  "description": "Professional 24/7 broadcast playout system for Windows",
  "main": "src/main.js",
  "author": "TridentSky",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/TridentSky/FlowAir",
  "repository": {
    "type": "git",
    "url": "https://github.com/TridentSky/FlowAir.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "vite --strictPort",
    "dist": "node ../build/build.js"
  },
  "keywords": [
    "playout",
    "broadcast",
    "streaming",
    "television"
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.tridentsky.flowair",
    "productName": "FlowAir",
    "copyright": "Copyright © 2026 TridentSky",
    "artifactName": "FlowAir-Setup.${ext}",
    "directories": {
      "buildResources": "../build",
      "output": "../.build/electron"
    },
    "files": [
      "src/main.js",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.build/backend/flowair-backend",
        "to": "backend"
      },
      {
        "from": "../ffmpeg/bin/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      }
    ],
    "fileAssociations": [
      {
        "ext": "flowair",
        "name": "FlowAir.Playlist",
        "description": "FlowAir Playlist"
      }
    ],
    "electronLanguages": [
      "en-US",
      "es",
      "es-419"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.ico",
      "executableName": "FlowAir",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlowAir",
      "uninstallDisplayName": "FlowAir",
      "installerIcon": "../build/icon.ico",
      "uninstallerIcon": "../build/icon.ico",
      "installerHeaderIcon": "../build/icon.ico",
      "installerSidebar": "../build/installerSidebar.bmp",
      "installerHeader": "../build/installerHeader.bmp",
      "include": "../build/installer.nsh",
      "deleteAppDataOnUninstall": true,
      "differentialPackage": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "en_US",
        "es_ES"
      ],
      "displayLanguageSelector": false
    }
  }
}
